# Copy to .env and adjust. Never commit the real .env file.
QMED_HOST=0.0.0.0
QMED_PORT=5000
# Leave empty to auto-generate a secret at data/server_secret.key on first run
QMED_SECRET_KEY=
QMED_DATABASE_URL=sqlite:///data/qmed.db
QMED_SESSION_HOURS=8
QMED_MAX_FILE_MB=10
QMED_ALLOWED_EXTENSIONS=txt,pdf,docx,csv,png,jpg,jpeg
QMED_QBER_THRESHOLD=0.11
QMED_PASSWORD_MIN_LENGTH=8
QMED_PASSWORD_REQUIRE_SYMBOL=false
QMED_ALLOW_SELF_SEND=false
